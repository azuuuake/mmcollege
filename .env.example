# PostgreSQL
DATABASE_URL=postgresql://mmconnect:mmconnect@localhost:5432/mmconnect

# API
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Local file storage (MVP). Replace with S3 later via StorageService.
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=10485760

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api
